# ============================================
# EJEMPLO DE VARIABLES DE ENTORNO
# ============================================
# ⚠️ IMPORTANTE: Este archivo contiene EJEMPLOS, NO valores reales
#
# Para usar:
# 1. Copia este archivo: cp .env.example .env
# 2. Edita .env con tus credenciales reales
# 3. NUNCA hagas commit de .env (ya está en .gitignore)
#
# Para obtener credenciales:
# - TMDB API Key: https://www.themoviedb.org/settings/api
# - Gmail App Password: https://myaccount.google.com/apppasswords
# ============================================

# ============================================
# BASE DE DATOS
# ============================================
# Para desarrollo local (PostgreSQL local)
DB_HOST=tmdb

# Para producción (Render te proporciona esto automáticamente)
# DATABASE_URL=postgresql://user:password@host:port/database

# ============================================
# SERVIDOR
# ============================================
SERVER_PORT=3001
NODE_ENV=development

# ============================================
# JWT SECRET
# ============================================
# Genera un string aleatorio largo y seguro
SECRET=tu_secret_jwt_super_secreto_y_aleatorio

# ============================================
# TMDB API
# ============================================
# Obtén tu API key en: https://www.themoviedb.org/settings/api
API_URL=https://api.themoviedb.org/3
API_KEY=tu_api_key_de_tmdb_aqui

# ============================================
# EMAIL (SMTP - Gmail)
# ============================================
# Genera una App Password en: https://myaccount.google.com/apppasswords
HOST_MAILER=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_email@gmail.com
SMTP_PASSWORD=tu_app_password_de_gmail_aqui

# Nota: Usar puerto 587 (TLS) en producción (Render)
# Puerto 465 (SSL) puede estar bloqueado en algunos servicios cloud

# ============================================
# FRONTEND URL (para emails de reset password)
# ============================================
# En desarrollo
FRONTEND_URL=http://localhost:3000

# En producción (Render)
# FRONTEND_URL=https://tu-app.onrender.com

